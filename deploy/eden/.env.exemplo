# Éden: chaves e ajustes DESTE computador.
# O arquivo .env nunca vai para o GitHub. Não cole estas chaves em conversas,
# e-mails ou prints.

# Chave de acesso do Éden (a "senha" do servidor). O iniciar-eden cria sozinho.
OPENJARVIS_API_KEY=

# Chaves das IAs: cole depois do "=", sem espaços e sem aspas.
# Precisa de pelo menos uma. OpenAI = ChatGPT e microfone; Anthropic = Claude.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: limite de gasto por mês, em dólares (padrão: 10 e 15).
# EDEN_LIMITE_OPENAI=10
# EDEN_LIMITE_ANTHROPIC=15
