# Éden: chaves e ajustes DESTE computador.
# O arquivo .env nunca vai para o GitHub. Não cole estas chaves em conversas,
# e-mails ou prints.

# Chave de acesso do Éden (a "senha" do servidor). O iniciar-eden cria sozinho.
OPENJARVIS_API_KEY=

# Chaves das IAs: cole depois do "=", sem espaços e sem aspas.
# Precisa de pelo menos uma. OpenAI = ChatGPT e microfone; Anthropic = Claude.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: limite de gasto por mês, em dólares (padrão: 10 e 15).
# EDEN_LIMITE_OPENAI=10
# EDEN_LIMITE_ANTHROPIC=15

# Opcional (Parte 3): Google Agenda. ID e segredo do "cliente" criado no
# Google Cloud (passo a passo no LEIA-ME, "Ligar a Google Agenda").
# Cole depois do "=" (a linha NÃO começa com #). Vazio = desligado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional (Parte 4): rotas e trânsito. Chave do TomTom (conta grátis em
# developer.tomtom.com). Cole depois do "=". Vazio = desligado.
TOMTOM_API_KEY=

# Opcional (Parte 4): Notion. Chave secreta da conexão interna "Éden"
# (notion.so/profile/integrations; passo a passo no LEIA-ME). Cole depois
# do "=". Vazio = desligado.
NOTION_API_KEY=
